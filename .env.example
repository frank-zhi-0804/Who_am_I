# Copy to .env beside serve.cjs. Never put secrets in dist or browser scripts.
OPENAI_API_KEY=
# Server-side only. HTTPS API base; root, /v1 and /v1/responses are supported.
OPENAI_BASE_URL=https://api.openai.com/v1
# Example for the authorized third-party provider: https://api.shuaiapi.com/v1
# Verified hosted provider configuration uses OPENAI_MODEL=gpt-6-luna.
# Your API account must have access to this model.
OPENAI_MODEL=gpt-5.5
# Optional structured extraction model; blank inherits OPENAI_MODEL.
# Example for the verified third-party extraction step: gpt-6-luna
OPENAI_EXTRACTION_MODEL=
WHOAMI_TIMEOUT_MS=90000
WHOAMI_MAX_TOOL_CALLS=4
WHOAMI_RESEARCH_TOKENS=4500
WHOAMI_EXTRACTION_TOKENS=3000
WHOAMI_REQUESTS_PER_MINUTE=4
WHOAMI_REQUESTS_PER_HOUR=30
WHOAMI_MAX_CONCURRENT=2
