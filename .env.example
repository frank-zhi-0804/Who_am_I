# Copy to .env beside serve.cjs. Never put secrets in dist or browser scripts.
OPENAI_API_KEY=
# Your API account must have access to this model.
OPENAI_MODEL=gpt-5.5
WHOAMI_TIMEOUT_MS=90000
WHOAMI_MAX_TOOL_CALLS=4
WHOAMI_RESEARCH_TOKENS=4500
WHOAMI_EXTRACTION_TOKENS=3000
WHOAMI_REQUESTS_PER_MINUTE=4
WHOAMI_REQUESTS_PER_HOUR=30
WHOAMI_MAX_CONCURRENT=2
